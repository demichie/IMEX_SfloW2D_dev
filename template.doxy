# Doxygen configuration for the IMEX-SfloW2D Fortran API.
# The publication workflow overrides OUTPUT_DIRECTORY, HTML_OUTPUT,
# GENERATE_HTML, GENERATE_LATEX and PROJECT_BRIEF. The @mainpage lives in
# src/IMEX_SfloW2D.f90; the Markdown file is a supplementary API guide.
# Fail on malformed/incomplete Doxygen; all modules/procedures are separately
# checked by TEST_SOURCE_DOCUMENTATION/check_documentation.py.
PROJECT_NAME           = "IMEX-SfloW2D"
PROJECT_BRIEF          = "Fortran API for a depth-averaged geophysical flow solver"
OUTPUT_DIRECTORY       = doc
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_FOR_FORTRAN   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/doxygen.warnings
WARN_IF_DOC_ERROR      = YES
INPUT                  = src docs/doxygen/mainpage.md
FILE_PATTERNS          = *.f90 *.F90 *.f95 *.F95
# Parse the explicitly listed API guide, but not GitHub-oriented src/ READMEs.
EXCLUDE_PATTERNS       = */README.md
RECURSIVE              = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
# Render source formulae in HTML without a LaTeX installation on the CI runner.
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE =
HAVE_DOT               = YES
DOT_GRAPH_MAX_NODES    = 80
