# IMEX-SfloW2D experimental fprettify settings.
# docs/FORTRAN_STYLE.md is authoritative; use --diff before editing.
# This does NOT enforce exact column-120 continuation markers or Doxygen.
indent = 4
strict-indent = true
line-length = 120

# Conservative trial: avoid modifying numerical/operator spacing,
# declarations, comments, names, or executable source tokens.
disable-whitespace = true
enable-decl = false
strip-comments = false
enable-replacements = false
