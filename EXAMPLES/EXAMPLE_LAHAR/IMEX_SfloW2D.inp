! VESUVIO v2 lahar input migrated to IMEX-SfloW2D dev, single-layer.
! Place all three ASC rasters under ./DEM relative to the run directory.
! A local 600 s single-layer run completed; conservative-field comparison remains pending.

&RUN_PARAMETERS
 RUN_NAME="VESUVIO_001_001",
 RESTART=T,
 T_START=  0.0D0     ,
 T_END=  600.00000000000000E-00,
 DT_OUTPUT=  600.0000000000000E-00,
 OUTPUT_CONS_FLAG=F,
 OUTPUT_ESRI_FLAG=F,
 OUTPUT_NETCDF_FLAG=T,
 OUTPUT_RUNOUT_FLAG=F,
 SERIAL_FLAG=F,
 VERBOSE_LEVEL=          0,
/

&NEWRUN_PARAMETERS
 X0=440995.0D0,
 Y0=4515991.0D0,
 COMP_CELLS_X=340,
 COMP_CELLS_Y=280,
 CELL_SIZE=50.D0,
 N_SOLID = 6 ,
 N_ADD_GAS = 0 ,
 RHEOLOGY_FLAG = T ,
 N_LAYERS = 1,
 GAS_FLAG = F,
 LIQUID_FLAG = T, 
 RADIAL_SOURCE_FLAG = F,
 COLLAPSING_VOLUME_FLAG = F ,
 SUBTRACT_INIT_FLAG = T ,
/

&SUBSTRATE_PARAMETERS
